#!/usr/bin/env bash
# jm-py-install: install the project with package manager $PKG_MGR (uv, pip or none), or run
# $INSTALL_CMD instead when set. The command is shell code (eval), so no set -u; pipefail is
# stricter than an inline step's default `bash -e`.
set -eo pipefail

if [ -n "$INSTALL_CMD" ]; then
  eval "$INSTALL_CMD"
  exit
fi
case "$PKG_MGR" in
  uv) uv sync --all-extras ;;
  pip) python -m venv .venv && .venv/bin/pip install -e '.[dev]' ;;
  none) ;;
  *) echo "unknown package-manager: $PKG_MGR" >&2; exit 1 ;;
esac
