#!/usr/bin/env bash
# Fake gh for the bats suite: answers `repo list` from $GH_FIXTURES/repos.json and `run list` with
# no runs, applying -q with jq as gh does.
set -euo pipefail
q=""; a=()
while [ $# -gt 0 ]; do
  case "$1" in -q|--jq) q=$2; shift ;; *) a[${#a[@]}]=$1 ;; esac
  shift
done
case "${a[*]}" in
  "repo list "*) out=$(cat "$GH_FIXTURES/repos.json") ;;
  "run list "*) out='[]' ;;
  *) echo "fake gh: unhandled: ${a[*]}" >&2; exit 99 ;;
esac
if [ -n "$q" ]; then printf '%s\n' "$out" | jq -r "$q"; else printf '%s\n' "$out"; fi
