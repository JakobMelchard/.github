#!/usr/bin/env bash
# move-major-tag: point the major tag of release $TAG (v1.4.2 -> v1) of $GITHUB_REPOSITORY at that
# release's commit, creating the tag if it does not exist. Run by self-release.yml.
set -euo pipefail

major=${TAG%%.*}
ref=$(gh api "repos/$GITHUB_REPOSITORY/git/ref/tags/$TAG")
sha=$(jq -r .object.sha <<<"$ref")
if [ "$(jq -r .object.type <<<"$ref")" = tag ]; then # annotated: dereference
  sha=$(gh api "repos/$GITHUB_REPOSITORY/git/tags/$sha" -q .object.sha)
fi
if gh api "repos/$GITHUB_REPOSITORY/git/ref/tags/$major" >/dev/null 2>&1; then
  gh api -X PATCH "repos/$GITHUB_REPOSITORY/git/refs/tags/$major" -f sha="$sha" -F force=true >/dev/null
else
  gh api -X POST "repos/$GITHUB_REPOSITORY/git/refs" -f ref="refs/tags/$major" -f sha="$sha" >/dev/null
fi
echo "$major -> $TAG ($sha)" | tee -a "$GITHUB_STEP_SUMMARY"
