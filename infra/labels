#!/usr/bin/env bash
# labels [repo…] — create or update every label declared in settings.json `labels` on each repo.
# No args: every non-archived repo in settings.json. Only declared labels are touched; other
# labels on a repo are listed, never deleted (release-please and Renovate add their own).
# Called by .github/workflows/labels.yml, or by hand from a clone of this repo.
# bash 3.2 compatible.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
S="$here/settings.json"
ORG=${ORG:-JakobMelchard}
for c in gh jq; do command -v "$c" >/dev/null 2>&1 || { echo "labels: needs $c" >&2; exit 1; }; done

if [ $# -eq 0 ]; then
  set --
  while IFS= read -r n; do set -- "$@" "$n"; done \
    < <(jq -r '.repos | to_entries[] | select(.value.archived != true) | .key' "$S")
fi

declared=$(jq -r '.labels | keys[]' "$S" | sort)
rc=0
for r in "$@"; do
  echo "$r"
  if ! live=$(gh label list -R "$ORG/$r" --limit 200 --json name -q '.[].name' 2>/dev/null); then
    echo "  skipped: cannot read $ORG/$r (missing, or no access)" >&2; rc=1; continue
  fi
  while IFS=$'\t' read -r name color desc; do
    if gh label create "$name" -R "$ORG/$r" --color "$color" --description "$desc" --force >/dev/null 2>&1; then
      echo "  $name"
    else
      echo "  FAILED $name" >&2; rc=1
    fi
  done < <(jq -r '.labels | to_entries[] | [.key, .value.color, (.value.description // "")] | @tsv' "$S")
  extra=$(comm -23 <(printf '%s\n' "$live" | sort) <(printf '%s\n' "$declared") | tr '\n' ' ')
  if [ -n "$extra" ]; then echo "  undeclared: $extra"; fi
done
exit $rc
