{
  "$comment": "Single source of truth for org + repo settings. Read by .github/infra (tofu) and by bin/org-repo (gh api). Keys under repo_defaults are github_repository / PATCH /repos attributes. Per-repo entries override. `labels` is applied to every non-archived repo by infra/labels (org-repo labels, labels.yml); undeclared labels are left alone.",
  "org": {
    "default_repository_permission": "read",
    "members_can_create_repositories": false,
    "members_can_create_public_repositories": false,
    "members_can_create_private_repositories": false,
    "members_can_create_pages": true,
    "web_commit_signoff_required": false
  },
  "repo_defaults": {
    "visibility": "private",
    "has_issues": true,
    "has_wiki": false,
    "has_projects": false,
    "allow_merge_commit": true,
    "allow_squash_merge": true,
    "allow_rebase_merge": true,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "PR_BODY",
    "delete_branch_on_merge": true,
    "allow_auto_merge": true,
    "allow_update_branch": true,
    "web_commit_signoff_required": false,
    "vulnerability_alerts": true,
    "archived": false
  },
  "repos": {
    ".agents": {
      "description": "Org agent rules and skills"
    },
    ".config": {
      "description": "Shared lint, format and tsconfig bases: npm package @jakobmelchard/config, plus copied ruff/gitleaks/editorconfig",
      "visibility": "public",
      "private_vulnerability_reporting": true
    },
    ".devcontainer": {
      "description": "Dev environments: base image, features, templates"
    },
    ".githooks": {
      "description": "Shared git hooks"
    },
    ".github": {
      "description": "Shared CI, composite actions, org infra as code",
      "visibility": "public",
      "has_wiki": true,
      "private_vulnerability_reporting": true
    },
    "JakobMelchard.github.io": {
      "description": "docs.melchard.org \u2014 GitHub Pages docs site",
      "visibility": "public",
      "has_wiki": true,
      "private_vulnerability_reporting": true
    },
    "agent-tg": {},
    "agentest": {},
    "assets": {},
    "attach": {},
    "bin": {
      "description": "Org tooling"
    },
    "cf": {
      "description": "Monorepo for Cloudflare Pages sites + shared tooling.",
      "allow_merge_commit": false,
      "allow_rebase_merge": false
    },
    "feedback-loop": {},
    "forgejo": {},
    "gsheet": {
      "description": "Go client + CLI for the Google Sheets API (shared module, nvim lua plugin)",
      "visibility": "public",
      "private_vulnerability_reporting": true
    },
    "habits": {
      "description": "Habits tracker \u2014 htmx+JSDoc consumer of JakobMelchard/core",
      "archived": true
    },
    "health": {
      "allow_merge_commit": false,
      "allow_rebase_merge": false
    },
    "hx": {
      "visibility": "public",
      "description": "htmx + JSDoc library: router, html, Store adapters",
      "private_vulnerability_reporting": true
    },
    "infra": {},
    "interviews": {
      "description": "Local transcription, audio-linked editing, and qualitative analysis of interview data"
    },
    "lift": {},
    "lyrics": {
      "description": "Lil Peep lyrics API worker"
    },
    "monitor": {},
    "observe": {
      "description": "Deployment-agnostic observability sidecar",
      "visibility": "public",
      "private_vulnerability_reporting": true
    },
    "remind": {},
    "template": {
      "description": "Repository template: set toolchain in template.json, bootstrap does the rest",
      "is_template": true
    },
    "transcriber": {
      "allow_merge_commit": false,
      "archived": true
    },
    "weiterbildungszeit": {
      "archived": true
    },
    "workouts": {
      "description": "Workout tracking server (Go, stdlib net/http, gsheet-backed)"
    }
  },
  "labels": {
    "bug": {
      "color": "d73a4a",
      "description": "Something does not behave as documented"
    },
    "enhancement": {
      "color": "a2eeef",
      "description": "New feature or request"
    },
    "documentation": {
      "color": "0075ca",
      "description": "Improvements or additions to documentation"
    },
    "duplicate": {
      "color": "cfd3d7",
      "description": "This issue or pull request already exists"
    },
    "good first issue": {
      "color": "7057ff",
      "description": "Good for newcomers"
    },
    "help wanted": {
      "color": "008672",
      "description": "Extra attention is needed"
    },
    "invalid": {
      "color": "e4e669",
      "description": "This does not seem right"
    },
    "question": {
      "color": "d876e3",
      "description": "Further information is requested"
    },
    "wontfix": {
      "color": "ffffff",
      "description": "This will not be worked on"
    },
    "fleet/docs-drift": {
      "color": "0e8a16",
      "description": "Reconciles AGENTS.md against reality"
    },
    "fleet/deps": {
      "color": "1d76db",
      "description": "Dependency bump, lockfile or vendored config refresh"
    },
    "fleet/test-gap": {
      "color": "5319e7",
      "description": "Adds tests for uncovered branches"
    },
    "fleet/ci-red": {
      "color": "b60205",
      "description": "CI failure triage"
    },
    "fleet/blocked": {
      "color": "d93f0b",
      "description": "Fleet hit a budget or safety stop"
    },
    "autorelease: pending": {
      "color": "ededed",
      "description": "release-please: release PR open"
    },
    "autorelease: tagged": {
      "color": "ededed",
      "description": "release-please: release tagged"
    }
  }
}
