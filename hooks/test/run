#!/usr/bin/env bash
# Exercise each hook script against good and bad inputs. Tools that are not installed are skipped
# and listed at the end; REQUIRE="tofu prettier" turns a skip of those into a failure.
# The hooks themselves fail on a missing tool; that path is covered once, via gofmt.
# bash 3.2 compatible.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
h="$root"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cd "$tmp" && git init -q .

n=0 bad=0 skipped=
ok() { n=$((n + 1)); if "$@" >/dev/null 2>&1; then :; else bad=$((bad + 1)); echo "FAIL (expected pass): $*"; fi; }
no() { n=$((n + 1)); if "$@" >/dev/null 2>&1; then bad=$((bad + 1)); echo "FAIL (expected fail): $*"; fi; }
msg() { printf '%s\n' "$1" >m; }
have() { command -v "$1" >/dev/null 2>&1; }
skip() { skipped="$skipped $1"; }

# conventional-commit
msg 'feat: add x';                  ok "$h/conventional-commit.sh" m
msg 'fix(api)!: drop v1';           ok "$h/conventional-commit.sh" m
msg 'Merge branch main';            ok "$h/conventional-commit.sh" m
msg 'fixup! feat: add x';           ok "$h/conventional-commit.sh" m
printf '# comment\n\nchore: x\n' >m; ok "$h/conventional-commit.sh" m
git config core.commentChar ';'
printf '; comment\n\nchore: x\n' >m; ok "$h/conventional-commit.sh" m
printf '# not a comment\n' >m;        no "$h/conventional-commit.sh" m
git config --unset core.commentChar
msg 'added stuff';                  no "$h/conventional-commit.sh" m
msg 'feature: add x';               no "$h/conventional-commit.sh" m
# a message past the pipe buffer, as `git commit -v` produces
{ echo 'feat: x'; echo; head -c 300000 /dev/zero | tr '\0' 'y'; echo; } >m; ok "$h/conventional-commit.sh" m
msg "feat: $(printf 'x%.0s' $(seq 1 66))"; ok "$h/conventional-commit.sh" m
msg "feat: $(printf 'x%.0s' $(seq 1 67))"; no "$h/conventional-commit.sh" m

# shell-syntax
printf '#!/usr/bin/env bash\necho ok\n' >good.sh
printf '#!/bin/sh\nif then\n' >bad
ok "$h/shell-syntax.sh" good.sh
no "$h/shell-syntax.sh" bad
# the shebang beats the name: a bash array in a .sh file is bash -n, not sh -n (dash rejects it)
printf '#!/bin/bash\na=(1 2)\n[[ ${a[1]} == 2 ]]\n' >arr.sh; ok "$h/shell-syntax.sh" arr.sh
printf '#!/usr/bin/env bash\nif then\n' >bad.sh; no "$h/shell-syntax.sh" bad.sh
printf 'if true; then :; fi\n' >posix.sh; ok "$h/shell-syntax.sh" posix.sh
printf 'if then\n' >bad2.sh; no "$h/shell-syntax.sh" bad2.sh
if have zsh; then
  # an extensionless file with a zsh shebang gets zsh -n, so zsh-only syntax passes
  printf '#!/usr/bin/env zsh\n[[ -n $ZDOTDIR/.zcompdump(#qN.mh+168) ]] && echo stale\n' >zfn; ok "$h/shell-syntax.sh" zfn
  printf '#!/bin/zsh\ncase x in\n' >zbad; no "$h/shell-syntax.sh" zbad
  printf '#!/usr/bin/env zsh\ncase x in\n' >bad.zsh; no "$h/shell-syntax.sh" bad.zsh
  # no shebang: the basename picks zsh, so zsh-only syntax (glob qualifier) passes and bash -n is not used
  printf '[[ -n $ZDOTDIR/.zcompdump(#qN.mh+168) ]] && echo stale\n' >q
  for f in .zshrc .zshenv .zprofile .zlogin q.zsh; do
    cp q "$f"; ok "$h/shell-syntax.sh" "$f"
    printf 'case x in\n' >"$f"; no "$h/shell-syntax.sh" "$f"
  done
else skip zsh; fi

# gofmt: rewrites and fails, then passes
if have gofmt; then
  printf 'package x\nfunc  F( ) {}\n' >x.go
  no "$h/gofmt.sh" x.go
  ok "$h/gofmt.sh" x.go
else skip gofmt; fi
# a missing tool fails instead of skipping: a PATH holding only what the script itself needs
mkdir nobin
for t in bash dirname; do ln -s "$(command -v "$t")" "nobin/$t"; done
printf 'package x\n' >y.go
no env PATH="$PWD/nobin" "$h/gofmt.sh" y.go
out=$(PATH="$PWD/nobin" "$h/gofmt.sh" y.go 2>&1); printf "%s" "$out" | grep -q "gofmt not found" || { bad=$((bad + 1)); echo "FAIL: missing-tool message"; }
n=$((n + 1))

# go-build: no go.mod is a no-op, a broken package fails
if have go; then
  ok "$h/go-build.sh"
  printf 'module x\n\ngo 1.21\n' >go.mod
  printf 'package x\nfunc F() int { return "s" }\n' >x.go
  no "$h/go-build.sh"
  printf 'package x\nfunc F() int { return 1 }\n' >x.go
  ok "$h/go-build.sh"
  rm -f go.mod x.go
else skip go; fi

# tofu-fmt
if have tofu || have terraform; then
  printf 'resource "a" "b" {\nx=1\n}\n' >m.tf
  ok "$h/tofu-fmt.sh" m.tf
  grep -q 'x = 1' m.tf || { bad=$((bad + 1)); echo "FAIL: tofu-fmt did not rewrite"; }
  n=$((n + 1))
else skip tofu; fi

# swift-format (macOS, or Linux with a swift toolchain)
if have swift-format || xcrun --find swift-format >/dev/null 2>&1; then
  printf 'let  x=1\n' >a.swift
  ok "$h/swift-format.sh" a.swift
  grep -q 'let x = 1' a.swift || { bad=$((bad + 1)); echo "FAIL: swift-format did not rewrite"; }
  n=$((n + 1))
else skip swift-format; fi

# xcodegen: no tracked spec passes without xcodegen, a tracked one fails without it
mkdir xbin
for t in bash dirname git; do ln -s "$(command -v "$t")" "xbin/$t"; done
ok env PATH="$PWD/xbin" "$h/xcodegen.sh"
mkdir sub
printf 'name: X\ntargets:\n  X:\n    type: tool\n    platform: macOS\n' >sub/project.yml
git add sub/project.yml
no env PATH="$PWD/xbin" "$h/xcodegen.sh"
out=$(PATH="$PWD/xbin" "$h/xcodegen.sh" 2>&1); printf "%s" "$out" | grep -q "xcodegen not found" || { bad=$((bad + 1)); echo "FAIL: xcodegen missing-tool message"; }
n=$((n + 1))
if have xcodegen; then
  ok "$h/xcodegen.sh"
  [ -d sub/X.xcodeproj ] || { bad=$((bad + 1)); echo "FAIL: xcodegen did not generate next to its spec"; }
  n=$((n + 1))
  printf 'name: X\ntargets:\n  X:\n    type: nope\n    platform: macOS\n' >sub/project.yml
  no "$h/xcodegen.sh"
else skip xcodegen; fi
git rm -q --cached -f sub/project.yml
rm -rf sub

# prettier
if [ -x node_modules/.bin/prettier ] || { have npx && npx --no-install prettier --version >/dev/null 2>&1; }; then
  printf "const a = 'x'\n" > p.js
  ok "$h/prettier.sh" p.js
  grep -q "const a = 'x'" p.js || { bad=$((bad + 1)); echo "FAIL: prettier rewrote file without config"; }
  n=$((n + 1))
  out=$("$h/prettier.sh" p.js 2>&1)
  printf "%s" "$out" | grep -q "no config found" || { bad=$((bad + 1)); echo "FAIL: prettier missing skip notice"; }
  n=$((n + 1))

  echo '{"prettier": {"semi": false}}' > package.json
  printf "const a = 'x';\n" > p.js
  ok "$h/prettier.sh" p.js
  grep -q "const a = \"x\"" p.js || { bad=$((bad + 1)); echo "FAIL: prettier did not format with config"; }
  n=$((n + 1))
  rm -f package.json p.js
else skip prettier; fi

# eslint
if [ -x node_modules/.bin/eslint ] || { have npx && npx --no-install eslint --version >/dev/null 2>&1; }; then
  printf "const a = 'x'\n" > e.js
  ok "$h/eslint.sh" e.js
  out=$("$h/eslint.sh" e.js 2>&1)
  printf "%s" "$out" | grep -q "no config found" || { bad=$((bad + 1)); echo "FAIL: eslint missing skip notice"; }
  n=$((n + 1))

  cat <<'EOF' > eslint.config.js
module.exports = [{
  rules: {
    "no-var": "error"
  }
}];
EOF
  printf "var a = 1\n" > e.js
  no "$h/eslint.sh" e.js
  printf "const a = 1\n" > e.js
  ok "$h/eslint.sh" e.js
  rm -f eslint.config.js e.js
else skip eslint; fi

for t in ${REQUIRE:-}; do
  case " $skipped " in *" $t "*) bad=$((bad + 1)); echo "FAIL: $t is required but not installed" ;; esac
done
echo "$((n - bad))/$n passed${skipped:+, skipped:$skipped}"
[ "$bad" -eq 0 ]
