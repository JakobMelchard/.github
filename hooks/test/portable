#!/usr/bin/env bash
# portable: fail on bash 4+ builtins in the hooks and tests; macOS ships bash 3.2.
set -euo pipefail
cd "$(dirname "$0")/.."

if grep -nE '(^|[^[:alnum:]_])(mapfile|readarray)([^[:alnum:]_]|$)|declare[[:space:]]+-A' ./*.sh test/run; then
  echo "bash 4+ construct found; macOS ships bash 3.2" >&2
  exit 1
fi
echo portable
